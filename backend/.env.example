# Server Configuration
PORT=4000
NODE_ENV=development
# For production, set to: production
# NEVER log sensitive data in production

# Security - REQUIRED FOR PRODUCTION
# Generate strong JWT secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-strong-jwt-secret-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_MIN_LENGTH=8

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,https://yourdomain.com
# For production, NEVER use *

# Database Configuration
# Development: SQLite (./data/library.db)
# Production (Render free tier): /tmp/data/library.db
# Production (paid/PostgreSQL): postgres://user:pass@host:port/dbname
DATABASE_PATH=./data/library.db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# File Upload Security
# Render free tier: use /tmp/uploads (read-only filesystem otherwise)
UPLOAD_DIR=/tmp/uploads
MAX_FILE_SIZE_MB=100
MAX_UPLOAD_REQUESTS_PER_HOUR=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# AI - OpenRouter (required for AI features)
# Get key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-4o-mini
# Rate limiting for AI API calls
AI_RATE_LIMIT_PER_HOUR=20
AI_COST_LIMIT_MONTHLY_USD=10

# Logging & Monitoring
LOG_LEVEL=info
# Options: debug, info, warn, error
LOG_FILE=./logs/app.log
ENABLE_REQUEST_LOGGING=true

# Security Headers
HSTS_MAX_AGE=31536000
ENABLE_HTTPS_REDIRECT=false
# Set to true in production
